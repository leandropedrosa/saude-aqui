# Copie para .env e ajuste os valores. NUNCA faça commit do .env.

# --- Banco de dados ---
POSTGRES_DB=saude_aqui
POSTGRES_USER=saude_aqui
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_URL=postgresql://saude_aqui:troque-esta-senha@db:5432/saude_aqui

# --- API ---
# Domínios autorizados a chamar a API (separados por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Fuso horário de todos os serviços ---
TZ=America/Sao_Paulo

# --- Coletor (fonte: CNES/DATASUS) ---
# Pasta do FTP com os arquivos mensais de profissionais (PFGOaamm.dbc)
CNES_FTP_PF=ftp://ftp.datasus.gov.br/dissemin/publicos/CNES/200508_/Dados/PF/
# API de dados abertos do Ministério da Saúde (estabelecimentos)
CNES_API_URL=https://apidadosabertos.saude.gov.br/cnes/estabelecimentos
# Código IBGE do município (6 dígitos, padrão do DATASUS) e UF
MUNICIPIO_IBGE=520549
UF=GO
# CNPJ da mantenedora (Município de Cidade Ocidental): separa unidades públicas das privadas
CNPJ_MANTENEDORA=36862621000121

# --- Desenvolvimento local ---
# Porta da API no seu computador (mude se a 8000 estiver ocupada)
API_PORTA=8000

# --- Front-end (opcional, fixado no build) ---
# Provedor de tiles do mapa. Vazio = OpenStreetMap (gratuito, uso leve).
# Se o tráfego crescer, use um provedor com plano gratuito (MapTiler, Stadia, Carto).
VITE_TILES_URL=
VITE_TILES_ATRIBUICAO=

# --- Coletor: portal de escalas da Prefeitura (fonte complementar) ---
PORTAL_URL=https://acessoainformacao.cidadeocidental.go.gov.br
PORTAL_ARQUIVOS_URL=https://nucleogov.s3.us-east-2.amazonaws.com/pf_cidadeocidental/outros/
# Só publicações com início a partir desta data são consideradas
PORTAL_DESDE=2026-01-01
