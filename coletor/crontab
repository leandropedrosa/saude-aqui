# Agendamento do coletor (lido pelo supercronic, no fuso de Brasília).
# Formato: minuto hora dia mês dia-da-semana comando
CRON_TZ=America/Sao_Paulo

# Uma vez por semana: segunda-feira às 02:00 (as fontes mudam no máximo
# uma vez por semana). Quando não há arquivo novo no DATASUS, a execução
# só registra "sem_novidade" na tabela coleta e termina.
0 2 * * 1 python /app/coletar.py
